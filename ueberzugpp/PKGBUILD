pkgname=ueberzugpp-git
pkgver=2.9.6.r0.g8b7a4c7
pkgrel=1
pkgdesc="A C++ rewrite of ueberzug"
arch=('aarch64')
url="https://github.com/jstkdng/ueberzugpp"
license=('GPL3')
depends=('opencv' 'libvips' 'libtbb' 'libspdlog')
makedepends=('git' 'cmake' 'build-essential' 'range-v3' 'extra-cmake-modules')
provides=('ueberzugpp' 'ueberzug')
conflicts=('ueberzugpp' 'ueberzug')
source=("git+$url.git")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/ueberzugpp"
  # Remove -Werror as seen in temp.sh
  sed -i 's/set(PROJECT_WARNINGS_CXX -Wall -Wextra -Wpedantic -Werror)//' CMakeLists.txt
}

build() {
  cd "$srcdir/ueberzugpp"
  
  # 1. Force the compiler to see the shim header in EVERY file
  # 2. Force the linker to include shmemu for everything
  export CXXFLAGS="$CXXFLAGS -I$PREFIX/include/opencv4 -include shmemu.h"
  export LDFLAGS="$LDFLAGS -lshmemu"

  cmake -B build \
    -DCMAKE_INSTALL_PREFIX=$PREFIX \
    -DCMAKE_BUILD_TYPE=Release \
    -DENABLE_WAYLAND=ON \
    -DENABLE_OPENCV=ON \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
    -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS" \
    -DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS"
    
  cmake --build build -j8
}

package() {
  cd "$srcdir/ueberzugpp"
  DESTDIR="$pkgdir" cmake --install build
}
